start:css=#tab1
key:ArrowLeft
expect:css=#first
key:ArrowDown
expect-not:css=#more
key:ArrowDown
expect:css=#last
key:ArrowDown
expect:css=#reply
key:ArrowUp*3
expect:css=#first
