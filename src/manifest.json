{
  "manifest_version": 3,
  "name": "TUI Navigator",
  "version": "0.1.95",
  "description": "Transform browsing into a Text-based User Interface navigation experience.",
  "permissions": [
    "storage",
    "activeTab",
    "pageCapture",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "site-rules.js",
        "ring-style.js",
        "engine.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "192": "icons/icon192.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "192": "icons/icon192.png",
    "512": "icons/icon512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "stats/stats.html",
        "stats/stats.js",
        "stats/stats.css",
        "stats/apexcharts.min.js",
        "stats/bootstrap.bundle.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
