// The report server: F10 > Report a problem posts its zip here, and
// scripts/pull-reports.js takes it away. See src/index.js.
{
  "name": "tui-reports",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    { "binding": "REPORTS", "bucket_name": "tui-reports" }
  ],
  // Five reports a minute from one address is plenty for a person.
  "ratelimits": [
    { "name": "UPLOADS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Off: request logs would keep senders' addresses, which docs/privacy.html says are not kept.
  "observability": { "enabled": false }
}
